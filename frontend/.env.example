# Supabase PostgreSQL Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-public-key

# Optional: FastAPI Render Backend URL
# If left empty, the frontend talks directly to Supabase and uses local storage fallback
VITE_API_URL=https://your-app-name.onrender.com
