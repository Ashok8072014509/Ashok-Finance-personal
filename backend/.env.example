# Optional: Supabase credentials
# If left blank, the backend automatically uses the built-in SQLite database (ashok_finance.db)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Server Port (default 8000, Render sets this dynamically via PORT)
PORT=8000
